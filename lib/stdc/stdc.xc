# stdc - declarations of standard libc functions/structs etc.
#
# Docs for each function include an excerpt from man(2) or man(3)
# for corresponding C function
#
mod stdc;

# Contains declarations from stdio.h
use mod io;

# Contains declarations from string.h
use mod str;

# Contains declarations from stdlib.h
use mod lib;

# Contains declarations from stdarg.h
use mod arg;
